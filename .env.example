# Contact form delivery (Resend — https://resend.com).
# Without all three, the form validates input but tells visitors that online
# messaging is not connected and shows the phone number and email instead.
RESEND_API_KEY=
# Comma-separated recipients, e.g. Info@americaneliteconsultants.com
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "American Elite <website@americaneliteenterprises.com>"
CONTACT_FROM_EMAIL=
