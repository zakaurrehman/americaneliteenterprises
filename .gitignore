# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artefacts
/test-results/
/playwright-report/

# allow the documented env template
!.env.example

# Original-website image archive (61.5 MB) — kept locally; the site uses
# copies in public/images/heritage/. See brand/original-site/README.md.
/brand/original-site/*
!/brand/original-site/README.md
